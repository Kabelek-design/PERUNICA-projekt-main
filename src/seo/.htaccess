RewriteEngine On

# Redirect explicit home-page aliases without redirecting DirectoryIndex requests.
RewriteCond %{HTTP_HOST} ^(?:www\.)?perunica\.pl(?::\d+)?$ [NC]
RewriteCond %{THE_REQUEST} "\s/+index\.(?:html|php)(?:[?\s])" [NC]
RewriteRule ^index\.(?:html|php)$ https://perunica.pl/ [R=301,L,NE,NC]

RewriteCond %{HTTP_HOST} ^www\.perunica\.pl(?::\d+)?$ [NC,OR]
RewriteCond %{HTTP_HOST} ^perunica\.pl(?::\d+)?$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.perunica\.pl(?::\d+)?$ [NC]
RewriteRule ^ https://perunica.pl%{REQUEST_URI} [R=301,L,NE]

<IfModule mod_headers.c>
    <FilesMatch "\.[0-9a-f]{8}\.(?:css|js|woff2)$|^[0-9a-f]{32}\.(?:png|jpe?g|webp|svg|gif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
    </IfModule>
</IfModule>
